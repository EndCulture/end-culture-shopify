<section class="featured"><div class="section-head"><h2>{{ section.settings.heading }}</h2><a href="{{ section.settings.collection.url }}">VIEW ALL →</a></div>
<div class="product-grid">{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}{% for i in (1..4) %}<div class="product-card placeholder"><div class="product-image">{{ 'product-' | append: i | placeholder_svg_tag }}</div><div class="product-meta"><span>END CULTURE PIECE {{ i }}</span><span>£60.00</span></div></div>{% endfor %}{% endfor %}</div></section>
{% schema %}{"name":"Featured collection","settings":[{"type":"text","id":"heading","label":"Heading","default":"NEW DROP"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","min":2,"max":8,"step":1,"default":4,"label":"Products"}],"presets":[{"name":"Featured collection"}]}{% endschema %}
