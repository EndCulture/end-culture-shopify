<section class="early-access" id="early-access">
  <div class="early-access-copy">
    <span class="micro">END CULTURE / EARLY ACCESS</span>
    <h2>GET IN<br>BEFORE<br>THE DROP.</h2>
  </div>
  <div class="early-access-form">
    <p>Join the END CULTURE list for Drop 001 release details, product reveals and early-access updates.</p>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter,early-access,drop-001">
      <div class="early-access-row">
        <input type="email" name="contact[email]" placeholder="EMAIL ADDRESS" aria-label="Email address" required>
        <button type="submit">GET EARLY ACCESS →</button>
      </div>
      {% if form.posted_successfully? %}<p class="early-access-success">YOU'RE IN. WATCH YOUR INBOX.</p>{% endif %}
      {{ form.errors | default_errors }}
    {% endform %}
    <small>DROP 001 / RELEASE DATE TBC</small>
  </div>
</section>
{% schema %}{"name":"Early Access","settings":[]}{% endschema %}
