<section class="cart"><h1>YOUR BAG</h1>{% if cart.item_count == 0 %}<p>YOUR BAG IS EMPTY.</p><a class="button dark" href="{{ routes.root_url }}#coming-soon">SHOP</a>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-item">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag }}{% endif %}<div><a href="{{ item.url }}">{{ item.product.title }}</a><p>{{ item.variant.title }}</p><input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}<div class="cart-total"><span>TOTAL</span><strong>{{ cart.total_price | money }}</strong></div><button name="checkout" class="add">CHECKOUT</button></form>{% endif %}</section>
{% schema %}{"name":"Cart","settings":[]}{% endschema %}
