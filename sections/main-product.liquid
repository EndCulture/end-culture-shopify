<section class="product-page"><div class="gallery">{% for image in product.images %}{{ image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: product.title }}{% endfor %}</div><div class="product-info"><p class="micro">END CULTURE®</p><h1>{{ product.title }}</h1><p class="price">{{ product.price | money }}</p>{% form 'product', product %}<label>SELECT SIZE</label><select name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — SOLD OUT{% endunless %}</option>{% endfor %}</select><button class="add" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}ADD TO BAG{% else %}SOLD OUT{% endif %}</button>{% endform %}<div class="description">{{ product.description }}</div><details><summary>FIT & DETAILS</summary><p>See product description for garment specifications and fit.</p></details><details><summary>DELIVERY & RETURNS</summary><p>Delivery and return terms are managed in your Shopify policy settings.</p></details></div></section>
{% schema %}{"name":"Product","settings":[]}{% endschema %}
