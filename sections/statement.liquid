<section class="statement"><p>{{ section.settings.kicker }}</p><h2>{{ section.settings.text }}</h2><a href="{% if section.settings.link != blank %}{{ section.settings.link }}{% else %}{{ routes.root_url }}#about{% endif %}">{{ section.settings.link_text }} →</a></section>
{% schema %}{"name":"Brand statement","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"END CULTURE / EST. 2026"},{"type":"textarea","id":"text","label":"Statement","default":"NOTHING LASTS. MAKE IT MEAN SOMETHING WHILE IT DOES."},{"type":"text","id":"link_text","label":"Link text","default":"OUR STORY"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Brand statement"}]}{% endschema %}
