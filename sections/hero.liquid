<section class="hero" {% if section.settings.image %}style="background-image:linear-gradient(0deg,rgba(0,0,0,.35),rgba(0,0,0,.1)),url('{{ section.settings.image | image_url: width: 2400 }}')"{% endif %}>
  <div class="hero-copy"><h1>{{ section.settings.heading }}</h1><div class="hero-bottom"><span>{{ section.settings.subheading }}</span><a class="button light" href="{% if section.settings.link != blank %}{{ section.settings.link }}{% else %}{{ routes.root_url }}#shop-categories{% endif %}">{{ section.settings.button }}</a></div></div>
</section>
{% schema %}{"name":"Campaign hero","settings":[{"type":"image_picker","id":"image","label":"Campaign image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"END CULTURE® / 2026"},{"type":"text","id":"heading","label":"Heading","default":"DROP 001 — AFTER HOURS"},{"type":"text","id":"subheading","label":"Subheading","default":"MADE FOR WHAT COMES AFTER."},{"type":"text","id":"button","label":"Button","default":"SHOP THE DROP"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Campaign hero"}]}{% endschema %}
