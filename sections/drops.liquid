<section class="drops-page">
  <header class="drops-page-head"><span class="micro">END CULTURE / RELEASE INDEX</span><h1>THE<br>DROPS.</h1><p>Each release gets a number. 001 is T-shirts. 002 is headwear. 003 is hoodies.</p></header>
  <div class="drops-page-grid">
    <a class="drop-release revealed" href="{{ routes.search_url }}?view=t-shirts"><span>DROP</span><strong>001</strong><div><h2>T-SHIRTS</h2><p>REVEALED / COMING SOON</p><em>ENTER DROP 001 →</em></div></a>
    <a class="drop-release revealed" href="{{ routes.search_url }}?view=hats"><span>DROP</span><strong>002</strong><div><h2>HATS</h2><p>REVEALED / COMING SOON</p><em>ENTER DROP 002 →</em></div></a>
    <div class="drop-release revealed drop-coming"><span>DROP</span><strong>003</strong><div><h2>HOODIES</h2><p>REVEALED / COMING SOON</p><em>DETAILS TO FOLLOW.</em></div></div>
  </div>
  <section class="drop-archive">
    <header class="drop-archive-head">
      <span class="micro">END CULTURE / ARCHIVE</span>
      <h2>RELEASE<br>ARCHIVE.</h2>
      <p>A permanent record of every END CULTURE release.</p>
    </header>
    <div class="drop-archive-list">
      <a class="archive-row archive-current" href="{{ routes.search_url }}?view=t-shirts">
        <span class="archive-number">001</span>
        <div class="archive-name"><strong>DROP 001</strong><small>EC001–EC005 / T-SHIRTS</small></div>
        <span class="archive-year">2026</span>
        <span class="archive-status">CURRENT RELEASE</span>
        <span class="archive-arrow">↗</span>
      </a>
      <a class="archive-row archive-current" href="{{ routes.search_url }}?view=hats">
        <span class="archive-number">002</span>
        <div class="archive-name"><strong>DROP 002</strong><small>EC006–EC007 / HEADWEAR</small></div>
        <span class="archive-year">2026</span>
        <span class="archive-status">COMING SOON</span>
        <span class="archive-arrow">↗</span>
      </a>
      <div class="archive-row archive-upcoming">
        <span class="archive-number">003</span>
        <div class="archive-name"><strong>DROP 003</strong><small>HOODIES</small></div>
        <span class="archive-year">—</span>
        <span class="archive-status">COMING SOON</span>
        <span class="archive-arrow">—</span>
      </div>
    </div>
  </section>
  <div class="drops-signup"><span class="micro">DON'T MISS THE NEXT REVEAL</span><h2>KNOW<br>BEFORE<br>EVERYONE.</h2>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter,drops-interest"><div class="interest-row"><input type="email" name="contact[email]" placeholder="YOUR EMAIL" required><button type="submit">JOIN THE LIST →</button></div>{% if form.posted_successfully? %}<p class="interest-success">YOU'RE ON THE LIST.</p>{% endif %}{{ form.errors | default_errors }}{% endform %}</div>
</section>
{% schema %}{"name":"Drops","settings":[]}{% endschema %}