{% if section.settings.announcement != blank %}<div class="announcement">{{ section.settings.announcement }}</div>{% endif %}
<header class="site-header">
  {% unless template.name == 'index' %}<a class="brand-logo" href="{{ routes.root_url }}"><img src="{{ 'end-culture-logo.svg' | asset_url }}" alt="{{ shop.name | escape }}"></a>{% else %}<span class="brand-logo-home-spacer" aria-hidden="true"></span>{% endunless %}
  <button class="menu-toggle" aria-label="Menu" aria-controls="PrimaryNavigation">MENU</button>
  <nav class="nav" id="PrimaryNavigation">
    <a href="{{ routes.search_url }}?view=t-shirts">T-SHIRTS</a>
    <a href="{{ routes.search_url }}?view=hats">HATS</a>
    <a href="{{ routes.search_url }}?view=drops">DROPS</a>
  </nav>
  <a class="cart-link" href="{{ routes.cart_url }}">BAG ({{ cart.item_count }})</a>
</header>
{% schema %}{"name":"Header","settings":[{"type":"text","id":"announcement","label":"Announcement","default":"DROP 001 — T-SHIRTS / COMING SOON"}]}{% endschema %}
