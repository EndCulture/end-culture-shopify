<section class="shirt-detail-page">
  <div class="shirt-detail-image"><img src="{{ 'White T Shirt.png' | asset_url }}" alt="END CULTURE T-shirt — White"></div>
  <div class="shirt-detail-info">
    <span class="micro">END CULTURE / DROP 001 / 001</span>
    <h1>END CULTURE<br>T-SHIRT — WHITE</h1>
    <div class="shirt-release-line"><span>DROP 001 / 001</span><span>COMING SOON</span></div>
    <p class="shirt-product-intro">Heavyweight 220gsm BCI cotton. The first piece from END CULTURE.</p>

    <div class="shirt-accordions"><details open><summary>PRODUCT DETAILS</summary><div class="shirt-specs">
      <h2>PRODUCT DETAILS</h2>
      <dl>
        <div><dt>MATERIAL</dt><dd>100% BCI Cotton</dd></div>
        <div><dt>WEIGHT</dt><dd>220gsm</dd></div>
      </dl>
      <div class="accreditations"><strong>ACCREDITATIONS</strong><p>Amfori BSCI · Fair Wear Foundation · B Corp · Better Cotton · Oeko-Tex Standard 100 · Peta Approved Vegan · REACH</p></div>
    </div></details><details><summary>SIZE GUIDE</summary><div class="shirt-size-guide">
      <h2>SIZE GUIDE</h2>
      <p class="size-label">TO FIT CHEST / INCHES</p>
      <table>
        <tbody>
          <tr><th>S</th><td>36/38</td></tr><tr><th>M</th><td>38/40</td></tr><tr><th>L</th><td>40/42</td></tr><tr><th>XL</th><td>42/44</td></tr><tr><th>2XL</th><td>45/47</td></tr>
        </tbody>
      </table>
      <p class="size-note">Sizes are approximate and intended as a guide only.</p>
    </div></details><details><summary>WASHING &amp; CARE</summary><div class="shirt-care">
      <h2>WASHING &amp; CARE</h2>
      <p>Wash at 30°C. Tumble dry low heat (1 dot). Iron low heat (1 dot). Do not bleach. Do not dry clean.</p>
    </div></details></div>

    <div class="shirt-interest">
      <h2>REGISTER YOUR INTEREST</h2>
      <p>Be first to know when this T-shirt becomes available.</p>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter,white-tshirt-interest">
        <input type="hidden" name="contact[note]" value="Interest: END CULTURE T-Shirt — White">
        <div class="interest-row"><input type="email" name="contact[email]" placeholder="YOUR EMAIL" aria-label="Email address" required><button type="submit">REGISTER INTEREST →</button></div>
        {% if form.posted_successfully? %}<p class="interest-success">YOU'RE ON THE LIST. WE'LL LET YOU KNOW.</p>{% endif %}
        {{ form.errors | default_errors }}
      {% endform %}
    </div>
    <a class="back-to-tees" href="{{ routes.search_url }}?view=t-shirts">← BACK TO T-SHIRTS</a>
  </div>
</section>
{% schema %}{"name":"White T-Shirt Detail","settings":[]}{% endschema %}
